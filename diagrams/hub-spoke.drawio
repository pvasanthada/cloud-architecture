      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="onprem" value="On-Prem Data Center" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EA4335;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="hub" value="Hub Network&#10;(connectivity, firewall, DNS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4285F4;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="330" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="spoke1" value="Spoke: Team A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34A853;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="spoke2" value="Spoke: Team B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34A853;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="340" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="spoke3" value="Spoke: Team C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#34A853;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="760" y="560" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="onprem" target="hub"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="hub" target="spoke1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="hub" target="spoke2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="hub" target="spoke3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note" value="No direct spoke-to-spoke peering by default" style="text;html=1;align=center;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="200" height="30" as="geometry" /></mxCell>
      </root>
